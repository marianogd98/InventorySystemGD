@page
@model Inventory.Web.Pages.LoginModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="row justify-content-center align-items-center min-vh-75 py-5">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-gradient-primary text-white text-center py-4 border-0">
                <div class="avatar-circle mx-auto mb-3 shadow-sm">
                    <i class="bi bi-shield-lock-fill fs-2 text-primary"></i>
                </div>
                <h4 class="fw-bold mb-1">Sistema de Inventario</h4>
                <p class="text-white-50 small mb-0">Ingresa tus credenciales para continuar</p>
            </div>
            <div class="card-body p-4 p-sm-5">
                <form method="post" id="loginForm" novalidate>
                    <div class="mb-3">
                        <label asp-for="Input.Username" class="form-label fw-semibold small text-uppercase letter-spacing-1">Usuario</label>
                        <div class="input-group">
                            <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-person-fill text-muted"></i></span>
                            <input asp-for="Input.Username" class="form-control border-start-0 ps-0" placeholder="admin" autofocus />
                        </div>
                        <span asp-validation-for="Input.Username" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label fw-semibold small text-uppercase letter-spacing-1">Contraseña</label>
                        <div class="input-group">
                            <span class="input-group-text bg-body-tertiary border-end-0"><i class="bi bi-key-fill text-muted"></i></span>
                            <input asp-for="Input.Password" type="password" class="form-control border-start-0 ps-0" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="Input.RememberMe" class="form-check-input" type="checkbox" id="rememberMeCheck" />
                        <label class="form-check-label small" for="rememberMeCheck">Recordar mi sesión</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold shadow-sm rounded-3">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Iniciar Sesión
                    </button>
                </form>

                <div class="mt-4 p-3 bg-body-tertiary rounded-3 border text-center">
                    <p class="small text-muted mb-1"><strong>Credenciales de Demostración:</strong></p>
                    <code class="d-inline-block px-2 py-1 bg-body rounded small">admin / admin123</code>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                Swal.fire({
                    icon: '@(Model.StatusType ?? "info")',
                    title: '@(Model.StatusTitle ?? "Notificación")',
                    html: '@Html.Raw(Model.StatusMessage)',
                    confirmButtonText: 'Aceptar',
                    confirmButtonColor: '#3085d6'
                });
            });
        </script>
    }
}
